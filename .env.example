# Configuração do E-mail para Leitura Automática (IMAP Gmail)
EMAIL_USER=vendashairuusstore@gmail.com

# Senha de App do Gmail (16 letras geradas em: Gerenciar Conta Google > Segurança > Senhas de App)
# NÃO use sua senha normal do Google! Gere uma "Senha de App" de 16 caracteres.
EMAIL_PASS=sua_senha_de_app_aqui

# Configurações do Servidor IMAP (Gmail)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

# URL da API do Painel onde as perguntas serão cadastradas
API_URL=http://localhost:3000/api/questions

# Intervalo de checagem (em segundos) se o modo IDLE reconectar
CHECK_INTERVAL_SECONDS=30
